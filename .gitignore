# Secrets — never commit these
.env
.env.*
*.pem
*.key

# Foundry build artifacts (regenerated by `forge build`/`forge test`)
cache/
out/

# Foundry deployment artifacts from local/dry-run script runs
broadcast/*/31337/
broadcast/**/dry-run/

# Vendored dependencies (lib/v4-core, lib/v4-periphery, lib/openzeppelin-contracts,
# lib/forge-std, and their own nested libs) — currently plain cloned
# directories, not git submodules, so they are not restorable via
# `git submodule update`. See README.md for how to reinstall them.
lib/

# OS / editor cruft
.DS_Store
.vscode/
.idea/
